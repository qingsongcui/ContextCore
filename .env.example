# ContextCore process-environment reference; NOT an auto-loaded dotenv file.
# Backend Settings uses BaseModel/os.getenv, not a dotenv loader.
# Copying this file to .env alone changes nothing. Prefer CLI --data-dir.
# Do not place real credentials in examples, shell history or version control.

# Service process only (optional). CLI serve sets both paths from --data-dir.
# Omit rather than assigning empty values when using platform defaults.
# CONTEXTCORE_DATA_DIR=/absolute/path/to/isolated-contextcore-data
# CONTEXTCORE_DB=/absolute/path/to/isolated-contextcore-data/contextcore.db

# Hook subprocess only: service destination; not a Vite proxy/API setting.
# CONTEXTCORE_BASE_URL=http://127.0.0.1:8420
# Hook subprocess only: path to the separately authorized owner-only token file.
# CONTEXTCORE_CREDENTIAL_PATH=/absolute/path/to/agent.token
# CONTEXTCORE_TOKEN is a hook-only direct-token override; deliberately not shown
# as an assignment. Prefer the generated 0600 credential file; never expose tokens.

# VITE_API_URL is not consumed by the current Vite configuration. Use ordinary
# dev (5173 -> 8420) or dev:isolated (15173 -> 18420), not an invented env switch.
# No session signing-secret configuration: web cookies contain random session IDs
# validated against an in-memory store. CONTEXTCORE_SESSION_SECRET is not used
# for cookie signing. Release identity is managed by prepared-release tooling,
# not a user-provided environment value in this example.
