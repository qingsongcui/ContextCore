{
  "name": "contextcore-frontend",
  "version": "1.0.0-beta.1",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/collect-licenses.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src --ext .js,.jsx",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev:isolated": "vite --config vite.isolated.config.mjs",
    "test": "vitest run",
    "test:management": "vitest run tests/management.test.jsx",
    "test:regressions": "vitest run tests/frontend-regressions.test.jsx tests/markdown-regressions.test.jsx"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^1.1.21",
    "postcss-selector-parser": "^7.1.7",
    "browserslist": "^4.29.4",
    "baseline-browser-mapping": "^2.11.32",
    "source-map-js": "^1.2.2",
    "nanoid": "^3.3.20",
    "esbuild": "^0.28.2"
  },
  "description": "ContextCore Frontend. Accessibility (ARIA compliant) support included."
}
